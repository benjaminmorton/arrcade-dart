{
  "name": "arrcade-notification-service",
  "version": "1.5.5",
  "description": "Notification service for Arrcade",
  "repository": "https://github.com/JagandeepBrar/Arrcade-Notification-Service",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development nodemon --config nodemon.json src/index.ts",
    "start:dev": "cross-env NODE_ENV=development nodemon --config nodemon.json src/index.ts | pino-pretty -c -t -l",
    "build": "tsc",
    "serve": "cross-env NODE_ENV=production ts-node -r dotenv/config dist/index.js",
    "publish": "npm run docker:build && npm run docker:push",
    "docker": "ts-node -r dotenv/config dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "author": "Jagandeep Brar",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@types/basic-auth": "^1.1.4",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^26.4.1",
    "axios": "^1.5.1",
    "basic-auth": "^3.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "ioredis": "^6.0.0",
    "node-typescript-compiler": "4.0.0",
    "pino": "^10.3.1",
    "ts-node": "^10.9.1",
    "tslog": "^5.1.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "pretty-quick": "^4.2.2"
  }
}
